# 로컬 개발 (docker compose up -d 기준)
DATABASE_URL=postgresql+psycopg://flowkit:flowkit@localhost:5432/flowkit
REDIS_URL=redis://localhost:6379/0

# Google 로그인: FE가 보낸 ID 토큰의 audience 검증에 사용
GOOGLE_CLIENT_ID=

# 32자 이상. 운영 배포 시 반드시 교체할 것
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploy

# BYOK 도입 전까지 사용하는 서버 공용 LLM 키
GOOGLE_API_KEY=
