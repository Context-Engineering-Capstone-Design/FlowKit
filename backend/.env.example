# 로컬 개발 (docker compose up -d 기준)
DATABASE_URL=postgresql+psycopg://flowkit:flowkit@localhost:5432/flowkit
REDIS_URL=redis://localhost:6379/0

# Google 로그인: FE가 보낸 ID 토큰의 audience 검증에 사용
GOOGLE_CLIENT_ID=

# 32자 이상. 운영 배포 시 반드시 교체할 것
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploy

# 사용자 API 키 암호화용 Fernet 키. 환경별로 새로 생성하고 외부에 공개하지 않는다.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# 로컬 첨부 원본 저장소와 기본 제한값
ATTACHMENT_STORAGE_DIR=.flowkit-attachments
ATTACHMENT_MAX_FILE_SIZE=10485760
ATTACHMENT_MAX_PER_MESSAGE=5
ATTACHMENT_TEMPORARY_HOURS=24
